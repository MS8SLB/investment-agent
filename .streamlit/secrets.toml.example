# Copie para .streamlit/secrets.toml (local) ou cole no painel «Secrets» do Streamlit Community Cloud.
# NUNCA faça commit do secrets.toml (está no .gitignore).

# Postgres partilhado (ex.: Supabase → Connect → Session pooler, que funciona em IPv4).
DATABASE_URL = "postgresql://postgres.xxxxxxxx:SUA_PASSWORD_BD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# CONTAS INDIVIDUAIS (recomendado): cria o 1.º administrador no primeiro arranque, se ainda não houver contas.
# Entre com este utilizador, defina a sua própria palavra-passe e crie as contas dos treinadores em «Utilizadores».
# Depois pode apagar ADMIN_PASSWORD destes segredos.
ADMIN_USERNAME = "admin"
ADMIN_PASSWORD = "palavra-passe-temporaria-longa"

# ALTERNATIVA SIMPLES (sem contas): uma palavra-passe única do clube. Ignorada se houver contas.
# APP_PASSWORD = "uma-frase-longa-e-unica"
